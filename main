// ─── Map setup ──────────────────────────────────────────────────────────────
let activeId = null;
let map;
let markerEls = {};
let polygonLayers = {};
let placeMarkers = {};
let activeCat = 'all';

const catColors = { architecture: '#ffb060', hotel: '#78c8ff', culture: '#c878ff' };
const catLabels = { architecture: 'Architecture', hotel: 'Hotel', culture: 'Cultural Space' };

const satelliteLayer = L.tileLayer(
  'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
  { attribution: 'Tiles © Esri', maxZoom: 19 }
);
const streetLayer = L.tileLayer(
  'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?key=cb1_3n8f_1_fe460409a7663140eb6085b3',
  { attribution: '© OpenStreetMap © CARTO', subdomains: 'abcd', maxZoom: 19 }
);

function setLayer(t) {
  if (t === 'satellite') { map.removeLayer(streetLayer); map.addLayer(satelliteLayer); }
  else { map.removeLayer(satelliteLayer); map.addLayer(streetLayer); }
  document.getElementById('btn-satellite').classList.toggle('active', t === 'satellite');
  document.getElementById('btn-street').classList.toggle('active', t === 'street');
}

function filterCat(cat) {
  activeCat = cat;
  document.querySelectorAll('.cfbtn').forEach(b => b.classList.toggle('active', b.dataset.cat === cat));
  places.forEach(p => {
    const m = placeMarkers[p.id];
    if (!m) return;
    if (cat === 'all' || p.cat === cat) m.addTo(map);
    else map.removeLayer(m);
  });
}

function buildPopupHTML(p) {
  const hood = hoods.find(h => h.id === p.neighbourhood);
  const accentColor = hood ? hood.color : '#fff';
  const catColor = catColors[p.cat];
  const warnHTML = p.warn ? `<p class="pop-warn">⚠ Verify still operating before visiting.</p>` : '';
  return `
    <div class="pop-header">
      <div class="pop-cat" style="color:${catColor}">${catLabels[p.cat]} · <span style="color:${accentColor}">${hood ? hood.name : ''}</span></div>
      <div class="pop-name">${p.name}</div>
    </div>
    <div class="pop-body">${p.body}${warnHTML}</div>
  `;
}

function makePlaceIcon(p) {
  const col = catColors[p.cat];
  const hood = hoods.find(h => h.id === p.neighbourhood);
  const borderCol = hood ? hood.color : col;
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
    <rect x="3" y="3" width="10" height="10" rx="2" fill="${col}" fill-opacity="0.9" stroke="${borderCol}" stroke-width="1.5" transform="rotate(45 8 8)"/>
  </svg>`;
  return L.divIcon({ html: svg, className: '', iconSize: [16, 16], iconAnchor: [8, 8], popupAnchor: [0, -10] });
}

function select(id) {
  activeId = id;
  const h = hoods.find(x => x.id === id);
  document.getElementById('wu-name').textContent = h.name;
  document.getElementById('wu-tag').textContent = h.tag;
  const body = document.getElementById('wu-body');
  body.textContent = h.body;
  body.classList.remove('wu-placeholder');
  document.querySelectorAll('.nbtn').forEach(b => b.classList.toggle('active', b.dataset.id === id));
  Object.entries(markerEls).forEach(([mid, el]) => el.classList.toggle('active', mid === id));
  hoods.forEach(hd => {
    const poly = polygonLayers[hd.id];
    if (!poly) return;
    if (hd.id === id) {
      poly.setStyle({ fillOpacity: 0.38, color: hd.color, weight: 2.5, opacity: 0.95, dashArray: null });
    } else {
      poly.setStyle({ fillOpacity: 0.07, color: hd.color, weight: 1, opacity: 0.3, dashArray: '5 3' });
    }
  });
  map.flyTo([h.lat, h.lng], h.zoom, { animate: true, duration: 0.9 });
}

window.addEventListener('load', () => {
  map = L.map('map', { center: [-33.438, -70.615], zoom: 13, zoomControl: true });
  satelliteLayer.addTo(map);

  // Neighbourhood polygons
  hoods.forEach(h => {
    const poly = L.polygon(h.polygon, {
      fillColor: h.color, fillOpacity: 0.20,
      color: h.color, weight: 1.8, opacity: 0.65, dashArray: '5 3'
    }).addTo(map);
    poly.on('click', () => select(h.id));
    polygonLayers[h.id] = poly;
  });

  // Neighbourhood markers
  hoods.forEach(h => {
    const el = document.createElement('div');
    el.className = 'nh-marker';
    el.style.background = h.color;
    el.textContent = h.abbr;
    markerEls[h.id] = el;
    const icon = L.divIcon({ html: el, className: '', iconSize: [32, 32], iconAnchor: [16, 16] });
    const m = L.marker([h.lat, h.lng], { icon }).addTo(map);
    m.on('click', () => select(h.id));
  });

  // Place pins with hover tooltips
  places.forEach(p => {
    const icon = makePlaceIcon(p);
    const marker = L.marker([p.lat, p.lng], { icon });
    marker.bindPopup(buildPopupHTML(p), {
      maxWidth: 270,
      className: 'place-popup',
      closeButton: true,
      autoClose: true
    });
    // Open on hover
    marker.on('mouseover', function() { this.openPopup(); });
    marker.addTo(map);
    placeMarkers[p.id] = marker;
  });

  // Sidebar
  const nblist = document.getElementById('nblist');
  hoods.forEach(h => {
    const btn = document.createElement('button');
    btn.className = 'nbtn';
    btn.dataset.id = h.id;
    btn.innerHTML = `<span class="dot" style="background:${h.color}"></span><span class="bname">${h.name}</span><span class="btag">${h.tag}</span>`;
    btn.addEventListener('click', () => select(h.id));
    nblist.appendChild(btn);
  });
});
</script>
</body>
</html>
